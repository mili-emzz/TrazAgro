# PostgreSQL 16 (Fuente de verdad transaccional ACID)
POSTGRES_USER=trazaagro
POSTGRES_PASSWORD=trazaagro_dev_pass
POSTGRES_DB=trazaagro
POSTGRES_PORT=5433
POSTGRES_URI=postgresql://trazaagro:trazaagro_dev_pass@localhost:5433/trazaagro

# MongoDB 7 (Repositorio documental de evidencias y certificados)
MONGO_INITDB_ROOT_USERNAME=trazaagro
MONGO_INITDB_ROOT_PASSWORD=trazaagro_dev_pass
MONGO_DB=trazaagro
MONGO_PORT=27017
MONGO_URI=mongodb://trazaagro:trazaagro_dev_pass@localhost:27017/trazaagro?authSource=admin

# Neo4j 5 (Red logistica y grafo de trazabilidad / recall)
NEO4J_USER=neo4j
NEO4J_PASSWORD=trazaagro_dev_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# Seguridad backend (para Fase 5)
JWT_SECRET_KEY=cambia_esta_clave_en_produccion
