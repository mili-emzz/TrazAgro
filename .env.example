# ==============================================================================
# CONFIGURACIÓN DE INFRAESTRUCTURA Y DESPLIEGUE LOCAL (Docker Compose)
# ==============================================================================

# PostgreSQL 16 (Administrador DDL y contenedor)
POSTGRES_USER=trazaagro
POSTGRES_PASSWORD=trazaagro_dev_pass
POSTGRES_DB=trazaagro
POSTGRES_PORT=5433

# MongoDB 7 (Administrador root y contenedor)
MONGO_INITDB_ROOT_USERNAME=trazaagro
MONGO_INITDB_ROOT_PASSWORD=trazaagro_dev_pass
MONGO_DB=trazaagro
MONGO_PORT=27017

# Neo4j 5 (Administrador y contenedor)
NEO4J_USER=neo4j
NEO4J_PASSWORD=trazaagro_dev_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ==============================================================================
# CONEXIONES DE LA API BACKEND (Principio de Menor Privilegio - trazaagro_app)
# ==============================================================================

# PostgreSQL: Usuario de aplicación con permisos exclusivos de DML (SELECT, INSERT, UPDATE, DELETE)
POSTGRES_URI=postgresql://trazaagro_app:trazaagro_app_pass@localhost:5433/trazaagro

# MongoDB: Usuario de aplicación con rol readWrite acotado a la base trazaagro
MONGO_URI=mongodb://trazaagro_app:trazaagro_app_pass@localhost:27017/trazaagro?authSource=trazaagro
MONGO_DB=trazaagro

# Neo4j: Conexión mediante protocolo Bolt
NEO4J_URI=bolt://localhost:7687

# Seguridad backend (JWT)
JWT_SECRET_KEY=cambia_esta_clave_en_produccion
